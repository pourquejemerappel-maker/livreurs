rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function userDoc(uid) { return /databases/$(db)/documents/users/$(uid); }
    function meExists() { return signed() && exists(userDoc(request.auth.uid)); }
    function me() { return get(userDoc(request.auth.uid)).data; }
    function active() { return meExists() && me().actif == true; }
    function isOwner() { return active() && me().role == 'proprio'; }
    function isStaff() { return active() && (me().role == 'complet' || me().role == 'limite'); }
    function isMember(id) { return active() && me().get('mid', '') == id; }
    function isComplet() { return active() && me().role == 'complet'; }
    function myId() { return me().get('mid', 'proprietaire'); }
    function setupDone() { return exists(/databases/$(db)/documents/public/setup); }

    // Indique seulement si le compte propriétaire existe déjà.
    match /public/setup {
      allow read: if true;
      allow create: if signed() && !setupDone()
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(userDoc(request.auth.uid)).data.role == 'proprio';
    }

    // Accès de connexion : un document par compte de connexion.
    match /users/{uid} {
      allow read: if signed() && (request.auth.uid == uid || isOwner());
      // Le tout premier compte (le propriétaire) se crée lui-même ; ensuite seul le propriétaire crée les accès.
      allow create: if (signed() && request.auth.uid == uid && !setupDone() && request.resource.data.role == 'proprio') || isOwner();
      allow update, delete: if isOwner();
    }

    // Nom de connexion → adresse interne. Lisible un par un (pour se connecter), jamais en liste.
    match /logins/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if isOwner();
    }

    // L'équipe : visible par le propriétaire et les dispatchs ; chacun voit sa propre fiche.
    match /members/{id} {
      allow read: if isOwner() || isStaff() || isMember(id);
      allow write: if isOwner();
    }

    // Paie par livraison : seulement le propriétaire et la personne elle-même.
    match /paies/{id} {
      allow read: if isOwner() || isMember(id);
      allow write: if isOwner();
    }

    // ---------- Stock ----------
    function cur(f) { return resource == null ? 0 : resource.data.get(f, 0); }
    function nv(f) { return request.resource.data.get(f, 0); }
    function positif() { return nv('L') >= 0 && nv('XL') >= 0; }
    // Dispatch limité : il peut seulement baisser son propre stock (quand il donne)
    // et seulement augmenter celui des autres (load à un livreur, retour à MOUSSE). Jamais l'inverse.
    function limiteOk(id) {
      return active() && me().role == 'limite' && positif() &&
        ((id == myId() && nv('L') <= cur('L') && nv('XL') <= cur('XL')) ||
         (id != myId() && nv('L') >= cur('L') && nv('XL') >= cur('XL')));
    }
    // Livreur : seulement en acceptant (son stock monte) ou en refusant (le stock retourne au dispatch)
    // un load qui lui était destiné, et exactement de la quantité du load.
    function livreurOk(id) {
      let sid = request.resource.data.get('via', '');
      let p = /databases/$(db)/documents/soirees/$(sid);
      let s0 = get(p).data;
      let s1 = getAfter(p).data;
      return active() && sid != '' && s0.mid == myId() && s0.statut == 'load' &&
        ((id == myId() && s1.statut == 'ouverte') || (id == s0.load.de && s1.statut == 'demande')) &&
        nv('L') == cur('L') + s0.load.L && nv('XL') == cur('XL') + s0.load.XL;
    }
    // Livraison : le stock du livreur baisse exactement de la commande qu'il marque « livrée ».
    function livraisonOk(id) {
      let cid = request.resource.data.get('cmd', '');
      let p = /databases/$(db)/documents/commandes/$(cid);
      let c0 = get(p).data;
      let c1 = getAfter(p).data;
      return active() && cid != '' && id == myId() && c0.livreur == myId() && c0.statut == 'ici' && c1.statut == 'livree' &&
        nv('L') == cur('L') - c0.L && nv('XL') == cur('XL') - c0.XL;
    }
    match /stocks/{id} {
      allow read: if isOwner() || isComplet() || isMember(id);
      allow create, update: if isOwner() || (isComplet() && positif()) || limiteOk(id) || livreurOk(id) || livraisonOk(id);
    }

    // Historique du stock : on ajoute, on ne modifie jamais.
    match /mouvements/{m} {
      allow read: if isOwner() || isStaff();
      allow create: if active() && request.resource.data.par == myId();
    }

    // ---------- Soirées (check-in) ----------
    match /soirees/{sid} {
      allow read: if isOwner() || isStaff() || (active() && resource.data.mid == myId());
      allow create: if active() && request.resource.data.mid == myId() && request.resource.data.statut == 'demande';
      allow update: if isOwner() || isStaff() ||
        (active() && resource.data.mid == myId() && request.resource.data.mid == resource.data.mid &&
         request.resource.data.get('load', null) == resource.data.get('load', null) &&
         ((resource.data.statut == 'demande' && request.resource.data.statut == 'annulee') ||
          (resource.data.statut == 'load' && request.resource.data.statut in ['ouverte', 'demande']) ||
          (resource.data.statut == 'ouverte' && request.resource.data.statut == 'ouverte' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['livrees']) &&
           request.resource.data.livrees == resource.data.get('livrees', 0) + 1) ||
          // Fin de soirée : le livreur ferme sa propre soirée.
          (resource.data.statut == 'ouverte' && request.resource.data.statut == 'terminee' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'finLe']))));
    }

    // ---------- Commandes ----------
    // Réglages (prix, clé Google Maps) : lus par l'équipe, changés par le propriétaire seulement.
    match /config/{id} {
      allow read: if active();
      allow write: if isOwner();
    }
    // Ce que le livreur voit de ses commandes. Il peut seulement : ajouter du retard, dire qu'il est arrivé,
    // marquer « livrée » (jamais si c'est bloqué / pas payé) avec le cash reçu.
    match /commandes/{cid} {
      allow read: if isOwner() || isStaff() || (active() && resource.data.livreur == myId());
      allow create, delete: if isOwner() || isStaff();
      allow update: if isOwner() || isStaff() ||
        (active() && resource.data.livreur == myId() && request.resource.data.livreur == myId() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['retard', 'statut', 'iciLe', 'livreeLe', 'cashRecu', 'soiree', 'depart', 'paie']) &&
         (!('paie' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.paie == get(/databases/$(db)/documents/paies/$(myId())).data.paie) &&
         request.resource.data.get('retard', 0) >= resource.data.get('retard', 0) &&
         ((resource.data.statut == 'assignee' && request.resource.data.statut in ['assignee', 'ici']) ||
          (resource.data.statut == 'ici' && request.resource.data.statut == 'ici') ||
          (resource.data.statut == 'ici' && request.resource.data.statut == 'livree' && resource.data.bloque == false)));
    }
    // Montants complets et Interac : jamais visibles par les livreurs.
    match /cmdPrive/{cid} {
      allow read, write: if isOwner() || isStaff();
    }

    // ---------- Lien de suivi du client (suivi.html#code) ----------
    // Le code secret dans le lien est le seul accès : on peut lire un suivi si on connaît son code, jamais la liste.
    function suiviDoc(t) { return get(/databases/$(db)/documents/suivi/$(t)).data; }
    match /suivi/{t} {
      allow get: if true;
      allow list: if false;
      allow create, delete: if isOwner() || isStaff();
      allow update: if isOwner() || isStaff() ||
        (signed() && resource.data.luid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eta', 'statut', 'actif']));
      // Messages : le client (sans compte) et le livreur de cette commande, seulement tant que c'est ouvert.
      match /msgs/{m} {
        allow read: if suiviDoc(t).actif == true || isOwner() || isStaff();
        allow create: if suiviDoc(t).actif == true &&
          request.resource.data.keys().hasOnly(['de', 'txt', 'img', 'le']) &&
          request.resource.data.le == request.time &&
          request.resource.data.txt is string && request.resource.data.txt.size() <= 300 &&
          (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() < 400000)) &&
          (request.resource.data.de == 'client' ||
           (request.resource.data.de == 'livreur' && signed() && suiviDoc(t).luid == request.auth.uid));
        allow delete: if isOwner() || isStaff() || (signed() && suiviDoc(t).luid == request.auth.uid);
      }
    }

    // ---------- Messages dispatch ↔ livreur ----------
    function msgOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['mid', 'de', 'par', 'nom', 'txt', 'img', 'le', 'tous']) && d.le == request.time && d.par == myId() &&
        d.txt is string && d.txt.size() <= 300 && (!('img' in d) || (d.img is string && d.img.size() < 400000));
    }
    match /messages/{m} {
      allow read: if isOwner() || isStaff() || (active() && resource.data.mid == myId());
      allow create: if active() && msgOk() &&
        (((isOwner() || isStaff()) && request.resource.data.de == 'dispatch') ||
         (request.resource.data.mid == myId() && request.resource.data.de == 'livreur'));
      allow delete: if isOwner() || isStaff();
    }
    // Dernière lecture (pour le rond rouge).
    match /lus/{mid} {
      allow read, write: if isOwner() || isStaff() || isMember(mid);
    }
    // Copie des messages effacés : le dispatch la crée en effaçant, seul le propriétaire la lit et l'efface.
    match /archives/{m} {
      allow create: if isOwner() || isStaff();
      allow read, delete: if isOwner();
    }

    // ---------- Cash remis au dispatch pendant la soirée ----------
    // Dispatchs en ligne (MOUSSE, lost) : chacun écrit seulement sa propre fiche.
    match /dispos/{id} {
      allow read: if active();
      allow write: if isStaff() && id == myId();
    }
    match /remises/{r} {
      allow read: if isOwner() || isStaff() || (active() && resource.data.de == myId());
      allow create: if active() && request.resource.data.de == myId() && request.resource.data.statut == 'attente' &&
        request.resource.data.keys().hasOnly(['de', 'deNom', 'vers', 'versNom', 'montant', 'statut', 'le']) &&
        request.resource.data.montant is int && request.resource.data.montant > 0 && request.resource.data.montant <= 100000 &&
        request.resource.data.le == request.time && request.resource.data.vers != myId() &&
        // MOUSSE (complet) → propriétaire seulement ; lost (limité) → un dispatch complet ; livreur → un dispatch en ligne.
        ((request.resource.data.vers == 'proprietaire' && isComplet()) ||
         (request.resource.data.vers != 'proprietaire' && !isComplet() &&
          exists(/databases/$(db)/documents/dispos/$(request.resource.data.vers)) &&
          (!isStaff() || get(/databases/$(db)/documents/dispos/$(request.resource.data.vers)).data.role == 'complet')));
      // Seul celui qui reçoit (dispatch ou propriétaire) confirme (Reçu / Pas reçu).
      allow update: if (isStaff() || isOwner()) && resource.data.vers == myId() && resource.data.statut == 'attente' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'recueLe']) &&
        request.resource.data.statut in ['recue', 'refusee'];
      // Le livreur peut annuler tant que ce n'est pas confirmé.
      allow delete: if active() && resource.data.de == myId() && resource.data.statut == 'attente';
    }

    // ---------- Dettes (« le client paie plus tard ») ----------
    // Le propriétaire et MOUSSE (complet) voient tout ; les autres seulement les leurs.
    match /dettes/{id} {
      allow read: if isOwner() || isComplet() ||
        (active() && (resource.data.responsable == myId() || resource.data.creePar == myId() || resource.data.livreur == myId()));
      allow create: if active() && request.resource.data.creePar == myId() && request.resource.data.creeLe == request.time &&
        request.resource.data.keys().hasOnly(['client', 'montant', 'responsable', 'livreur', 'livreurNom', 'cmd', 'note', 'statut', 'creePar', 'creeParNom', 'creeLe']) &&
        request.resource.data.montant is int && request.resource.data.montant >= 0 && request.resource.data.montant <= 100000 &&
        request.resource.data.note is string && request.resource.data.note.size() <= 120 &&
        (((isOwner() || isComplet()) && request.resource.data.statut in ['ouverte', 'attente_livreur']) ||
         (request.resource.data.statut == 'demande' && request.resource.data.livreur == myId() && request.resource.data.responsable in [myId(), 'dispatch']));
      // Propriétaire / MOUSSE : accepter, refuser, régler.
      // Livreur nommé responsable : confirmer, ou « pas moi » (ça revient à celui qui l'a créée).
      allow update: if isOwner() || isComplet() ||
        (active() && resource.data.responsable == myId() && resource.data.statut == 'attente_livreur' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'responsable', 'note', 'confirmeLe']) &&
         request.resource.data.statut == 'ouverte' &&
         (request.resource.data.responsable == myId() || request.resource.data.responsable == resource.data.creePar) &&
         request.resource.data.note is string && request.resource.data.note.size() <= 160);
    }

    // ---------- Fin de soirée : stock rendu à MOUSSE ----------
    match /retours/{r} {
      allow read: if isOwner() || isStaff() || (active() && resource.data.de == myId());
      allow create: if active() && request.resource.data.de == myId() && request.resource.data.statut == 'attente' &&
        request.resource.data.keys().hasOnly(['de', 'deNom', 'vers', 'versNom', 'L', 'XL', 'statut', 'soiree', 'le']) &&
        request.resource.data.L is int && request.resource.data.XL is int && request.resource.data.L >= 0 && request.resource.data.XL >= 0 &&
        request.resource.data.L <= get(/databases/$(db)/documents/stocks/$(myId())).data.get('L', 0) &&
        request.resource.data.XL <= get(/databases/$(db)/documents/stocks/$(myId())).data.get('XL', 0) &&
        request.resource.data.le == request.time &&
        get(/databases/$(db)/documents/dispos/$(request.resource.data.vers)).data.role == 'complet';
      allow update: if isComplet() && resource.data.vers == myId() && resource.data.statut == 'attente' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'decideLe']) &&
        request.resource.data.statut in ['recue', 'refusee'];
    }

    // Un document par téléphone qui accepte les notifications (lu seulement par le programme « notifier »).
    match /tokens/{t} {
      allow create, update: if active() && request.resource.data.mid == myId();
      allow delete: if active() && resource.data.mid == myId();
      allow read: if false;
    }

    // Test en direct (première version).
    match /test/{id} {
      allow read, write: if signed();
    }
  }
}
